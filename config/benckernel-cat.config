# BENCkernel-CAT: distribution choices on top of the hardware config
# (s22flip.config). See docs/DECISIONS.md.

# Root on btrfs, mountable without the initramfs (D005)
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# /boot is ext2 on the cache partition, read by lk2nd (D002)
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# /home on the microSD card (D001)
CONFIG_F2FS_FS=m
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y

# Swap on compressed RAM (D001)
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# pacman-sd runs apps with an overlaid /usr (D006)
CONFIG_OVERLAY_FS=m
CONFIG_USER_NS=y

# The kernel's own config, for packaging and debugging
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# The release is set by the build script
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# Arch's sysctl default (10-arch.conf) sets net.core.default_qdisc = fq_codel
CONFIG_NET_SCH_FQ_CODEL=y

# pacman 7 sandboxes its downloads with Landlock; without it, pacman -Sy fails
# on the phone (CONFIG_LSM already lists landlock)
CONFIG_SECURITY_LANDLOCK=y

# s22-sensord serves the ADSP's sensor registry (QMI 0x10f) from userspace;
# the in-kernel server would register a second one if its file existed
# CONFIG_QCOM_SNS_REG is not set

# Read-only WiFi debug files (mac80211 station/aggregation state, wcn36xx
# firmware info) for the throughput work; no effect unless read
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_WCN36XX_DEBUGFS=y

# IMS: Android's modem proxy copies IMS ports back to the modem's link-local
# address with -j TEE (s22-imsd, VoLTE registration)
CONFIG_NETFILTER_XT_TARGET_TEE=m
# Rate limits on the IMS proxy rules (first tests of forwarding rules)
CONFIG_NETFILTER_XT_MATCH_LIMIT=m

# Fewer idle wakeups (D031): RCU callbacks run from kthreads on every CPU and
# lazy ones are batched for seconds instead of starting a grace period each
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
