def setting(key, default):
    try:
        with open(SETTINGS) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k == key:
                    return v
    except OSError:
        pass
    return default


def earpiece_volume():
    """RX1 Digital Volume for the call_volume setting (as s22-wm has it)"""
    try:
        level = max(1, min(7, int(setting("call_volume", CALL_VOL_DEF))))
    except ValueError:
        level = CALL_VOL_DEF
    return str(84 + (level - CALL_VOL_DEF) * 4)


def speaker_call_volume():
    """Speaker Volume (0.5 dB units) for the call_volume setting, as s22-wm
    has it: -4 dB (stock's top) at 7, 2 dB a step"""
    try:
        level = max(1, min(7, int(setting("call_volume", CALL_VOL_DEF))))
    except ValueError:
        level = CALL_VOL_DEF
    return str(184 - (7 - level) * 4)


