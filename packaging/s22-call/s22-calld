PULSE_SERVER = "unix:" + PIPEWIRE_DIR + "/pulse/native"
OURS = ("s22-play", "s22-calld")        # application.name: ringtone, speech, tones


def pactl(*args):
    return subprocess.run(["pactl", *args], env=dict(os.environ, PULSE_SERVER=PULSE_SERVER),
                          capture_output=True, text=True, timeout=5)


def as_gui_user(*cmd):
    """cmd in the GUI's session (its D-Bus), as the user who owns it"""
    st = os.stat(PIPEWIRE_DIR)
    env = dict(os.environ, XDG_RUNTIME_DIR=PIPEWIRE_DIR,
               DBUS_SESSION_BUS_ADDRESS="unix:path=%s/bus" % PIPEWIRE_DIR)
    return subprocess.run(list(cmd), env=env, user=st.st_uid, group=st.st_gid,
                          extra_groups=[], capture_output=True, text=True, timeout=5)


class Media:
    """Other sound while a call rings (turned down) or has audio (muted,
    players paused, new streams muted as they come), put back after. In a
    thread of its own: set() returns at once"""
    DUCK_DB = 12
    # Pulse volumes are cubic (60% is -13 dB), so a cut in dB is this factor
    DUCK = 10 ** (-DUCK_DB / 60)

    def __init__(self):
        self.want = self.mode = None
        self.cv = threading.Condition()
        self.lock = threading.RLock()
        self.ducked = {}            # sink input -> its volumes before
        self.muted = set()
        self.paused = []            # MPRIS players
        self.sub = None
        threading.Thread(target=self.run, daemon=True).start()

    def set(self, mode):
        """None, "duck" or "stop" """
        with self.cv:
            if mode != self.want:
                self.want = mode
                self.cv.notify()

    def run(self):
        while True:
            with self.cv:
                while self.want == self.mode:
                    self.cv.wait()
                mode = self.want
            try:
                self.apply(mode)
            except (OSError, subprocess.SubprocessError, ValueError) as e:
                log("other sound: %s" % e)
            self.mode = mode

    def streams(self):
        """(index, volumes, muted) of each stream not ours"""
        try:
            data = json.loads(pactl("-f", "json", "list", "sink-inputs").stdout or "[]")
        except ValueError:
            return []
        out = []
        for s in data:
            p = s.get("properties", {})
            if p.get("node.name", "").startswith("s22.") or p.get("application.name") in OURS:
                continue
            vols = [ch.get("value", 65536) for ch in s.get("volume", {}).values()]
            out.append((s["index"], vols, s.get("mute", False)))
        return out

    def mute_all(self):
        with self.lock:
            for idx, _vols, muted in self.streams():
                if not muted:
                    pactl("set-sink-input-mute", str(idx), "1")
                    self.muted.add(idx)

    def watch(self, on):
        """New streams muted as they come, while on"""
        if on and not self.sub:
            self.sub = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True,
                                        env=dict(os.environ, PULSE_SERVER=PULSE_SERVER))
            sub = self.sub

            def read():
                for line in sub.stdout:
                    if "'new' on sink-input" in line and self.sub is sub:
                        self.mute_all()
            threading.Thread(target=read, daemon=True).start()
        elif not on and self.sub:
            sub, self.sub = self.sub, None
            sub.terminate()
            try:
                sub.wait(2)
            except subprocess.TimeoutExpired:
                sub.kill()

    def players(self, action):
        """The MPRIS players playing paused (and kept), or those played"""
        if action == "pause":
            names = as_gui_user("playerctl", "-l").stdout.split()
            for n in names:
                if as_gui_user("playerctl", "-p", n, "status").stdout.strip() == "Playing":
                    as_gui_user("playerctl", "-p", n, "pause")
                    self.paused.append(n)
        else:
            for n in self.paused:
                as_gui_user("playerctl", "-p", n, "play")
            self.paused = []

    def apply(self, mode):
        if not os.path.exists(PIPEWIRE_DIR + "/pulse/native"):
            return
        if mode == "stop":
            self.mute_all()             # at once; the players' pause after
            self.watch(True)
            self.players("pause")
            log("other sound stopped (%d streams, players %s)" %
                (len(self.muted), " ".join(self.paused) or "none"))
        elif mode == "duck":
            if self.mode == "stop":
                return                  # still muted, a call ringing after one
            with self.lock:
                for idx, vols, _muted in self.streams():
                    if idx not in self.ducked:
                        self.ducked[idx] = vols
                        pactl("set-sink-input-volume", str(idx),
                              *[str(int(v * self.DUCK)) for v in vols])
            dbg("other sound turned down (%d streams)" % len(self.ducked))
        else:
            self.watch(False)
            with self.lock:
                for idx in self.muted:
                    pactl("set-sink-input-mute", str(idx), "0")
                for idx, vols in self.ducked.items():
                    pactl("set-sink-input-volume", str(idx), *[str(v) for v in vols])
                back = len(self.muted) + len(self.ducked)
                self.muted, self.ducked = set(), {}
            self.players("play")
            if back:
                log("other sound back (%d streams)" % back)


# ------------------------------------------------------------------ input
def find_inputs():
    """(vibrator fd, [key/switch fds]) from /dev/input"""
    vib, keys = None, []
    for n in sorted(os.listdir("/dev/input")):
        if not n.startswith("event"):
            continue
        try:
            fd = os.open("/dev/input/" + n, os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            continue
        name = bytearray(64)
        try:
            fcntl.ioctl(fd, (2 << 30) | (64 << 16) | (ord("E") << 8) | 0x06, name)
        except OSError:
            pass
        name = name.split(b"\0")[0].decode(errors="replace")
        ff = bytearray(16)
        try:
            fcntl.ioctl(fd, (2 << 30) | (16 << 16) | (ord("E") << 8) | (0x20 + EV_FF), ff)
        except OSError:
            pass
        if vib is None and ff[0x50 // 8] & (1 << (0x50 % 8)):          # FF_RUMBLE
            vib = fd
        elif name in ("pm8941_pwrkey", "GPIO Buttons", "S22 Flip keypad (T9)"):
            keys.append(fd)
            dbg("input %s: %s" % (n, name))
        else:
            os.close(fd)
    return vib, keys


class Ringer:
    """Repeating vibration through an FF_RUMBLE effect"""
    def __init__(self, fd):
        self.fd, self.id = fd, -1

    def pulse(self, ms, strength=100):
        if self.fd is None:
            return
        # struct ff_effect (arm64, 48 bytes): type, id, direction,
        # trigger{button, interval}, replay{length, delay}, 2 bytes padding,
        # then the union (8-byte aligned, 32 bytes): rumble{strong, weak}
        mag = 0xffff * max(0, min(100, strength)) // 100
        eff = struct.pack("<HhHHHHH2xHH", 0x50, self.id, 0, 0, 0, ms, 0, mag, 0) + b"\0" * 28
        buf = bytearray(eff)
        try:
            fcntl.ioctl(self.fd, (1 << 30) | (len(eff) << 16) | (ord("E") << 8) | 0x80, buf)
            self.id = struct.unpack_from("<h", buf, 2)[0]
            os.write(self.fd, struct.pack("<qqHHi", 0, 0, EV_FF, self.id, 1))
        except OSError as e:
            dbg("vibrate: %s" % e)


# ------------------------------------------------------------------ main
def main():
    import gi
    gi.require_version("Qmi", "1.0")
    gi.require_version("Qrtr", "1.0")
    from gi.repository import GLib, Qmi, Qrtr

    ctx = GLib.MainContext.default()

    def wait(start, finish):
        box = []
        start(lambda _s, res, *_: box.append(res))
        while not box:
            ctx.iteration(True)
        return finish(box[0])

    def req(client, name, inp, timeout=30):
        out = wait(lambda cb: getattr(client, name)(inp, timeout, None, cb),
                   getattr(client, name + "_finish"))
        out.get_result()
        return out

    bus = wait(lambda cb: Qrtr.Bus.new(1000, None, cb), Qrtr.Bus.new_finish)
    while True:
        try:
            node = wait(lambda cb: bus.wait_for_node(0, 30000, None, cb),
                        bus.wait_for_node_finish)
            break
        except GLib.Error:
            dbg("waiting for the modem")
    dev = wait(lambda cb: Qmi.Device.new_from_node(node, None, cb),
               Qmi.Device.new_from_node_finish)
    wait(lambda cb: dev.open(Qmi.DeviceOpenFlags(0), 15, None, cb), dev.open_finish)
    voice = wait(lambda cb: dev.allocate_client(Qmi.Service.VOICE, 0, 10, None, cb),
                 dev.allocate_client_finish)
    i = Qmi.MessageVoiceIndicationRegisterInput()
    i.set_call_notification_events(True)
    try:
        req(voice, "indication_register", i)
    except GLib.Error as e:
        log("indication register: %s" % e.message)

    audio = Audio()
    mix(MEDIA_SPEAKER)          # a call's routing left by a restart: undone
    ringback = Ringback()
    tones = Tones()
    media = Media()
    ringtone = Ringtone()
    vib, keys = find_inputs()
    ringer = Ringer(vib)
    calls = {}                 # id -> {"state", "dir", "number", "first", "talk", ...}
    st = {"ring_on": False, "mute": False, "near": False, "prox": None}

    def prox_line(sock, _cond):
        try:
            data = sock.recv(4096).decode(errors="replace")
        except OSError:
            data = ""
        if not data:                        # s22-sensord went away
            st["prox"][0].close()
            st["prox"] = None
            if st["near"]:
                st["near"] = False
                write_state()
            return False
        for line in data.splitlines():
            p = line.split()
            if len(p) >= 2 and p[0] == "proximity":
                near = p[1] == "1"
                if near != st["near"]:
                    st["near"] = near
                    write_state()
        return True

    def prox_on():
        """Hold the proximity sensor while a call has audio"""
        if st["prox"]:
            return
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(SENSORD)
            s.sendall(b"proximity\n")
        except OSError as e:
            log("proximity: %s" % e)
            s.close()
            return
        st["prox"] = (s, GLib.io_add_watch(s.fileno(), GLib.IO_IN | GLib.IO_HUP,
                                           lambda *_: prox_line(s, _)))
        dbg("proximity held")

    def prox_off():
        if st["prox"]:
            s, src = st["prox"]
            st["prox"] = None
            try:
                GLib.source_remove(src)
            except Exception:
                pass
            s.close()
        if st["near"]:
            st["near"] = False
            write_state()

    def write_state():
        if not os.path.isdir(STATE_DIR):       # callers' numbers: wheel only
            os.makedirs(STATE_DIR, mode=0o750)
            try:
                os.chown(STATE_DIR, 0, grp.getgrnam("wheel").gr_gid)
            except (KeyError, OSError):
                pass
        text = "".join("call %d %s %s %d %s\n" % (
            cid, c["dir"], c["state"], int(c.get("talk") or c.get("first", 0)),
            c["number"] or "-") for cid, c in sorted(calls.items()))
        # On the speaker it is not at the ear, whatever the sensor says
        text += "mute=%d\nnear=%d\nspeaker=%d\n" % (
            st["mute"], st["near"] and not audio.speaker, audio.speaker)
        try:
            with open(STATE + ".new", "w") as f:
                f.write(text)
            os.replace(STATE + ".new", STATE)
        except OSError as e:
            log("state: %s" % e)

    def ended(cid, c):
        talk = int(time.time() - c["talk"]) if c.get("talk") else 0
        if c["dir"] == "mo":
            result = "outgoing" if c.get("talk") else "unanswered"
        else:
            result = "answered" if c.get("talk") else \
                "rejected" if c.get("rejected") else "missed"
        log_call(c, result, talk)
        if result == "missed":
            subprocess.run(["s22-notify", "-s", "missed-call", "-o", "call:recents",
                            "-f", c["number"] or "",
                            "Missed call from %s" % who(c["number"])])

    def numbers_of(out):
        nums = {}
        try:
            for e in out.get_remote_party_number():
                n = getattr(e, "type", None)
                nums[e.id] = n if isinstance(n, str) else ""
        except (GLib.Error, AttributeError, TypeError):
            pass
        return nums

    def update(out):
        nums = numbers_of(out)
        try:
            info = out.get_call_information()
        except GLib.Error:
            return
        for c in info:
            state = Qmi.VoiceCallState(c.state).value_nick
            old = calls.get(c.id, {})
            prev = old.get("state")
            cur = dict(old)
            cur.update(state=state, dir=Qmi.VoiceCallDirection(c.direction).value_nick,
                       number=nums.get(c.id) or old.get("number", ""))
            cur.setdefault("first", time.time())
            if state == "conversation" and not cur.get("talk"):
                cur["talk"] = time.time()
            calls[c.id] = cur
            if state in ("origination", "cc-in-progress") and state != prev:
                # Connected or ended well within a minute; else ask the modem
                cid, since = c.id, cur["first"]
                GLib.timeout_add_seconds(STUCK_CALL_S, lambda: (
                    calls.get(cid, {}).get("first") == since and
                    calls[cid]["state"] in ("origination", "cc-in-progress") and
                    reconcile("stuck dialling")) and False)
            if state != prev:
                log("call %d %s: %s" % (c.id, cur["dir"], state))
                if state == "incoming":
                    subprocess.run(["s22-notify", "-s", "call", "-o", "call:incoming",
                                    "Incoming call: %s" % who(cur["number"])])
                elif prev in ("incoming", "waiting"):
                    clear_call_notes()
            if state in ("end",):
                ended(c.id, calls.pop(c.id))
        if not calls:
            st["mute"] = False
        react()
        write_state()

    def react():
        states = {c["state"] for c in calls.values()}
        if any(c["dir"] == "mo" and c["state"] == "alerting" for c in calls.values()):
            ringback.on()
        else:
            ringback.off()
        if states & {"conversation", "hold", "alerting", "origination", "cc-in-progress"}:
            audio.on()
            prox_on()
        elif not states - {"incoming", "waiting"}:
            audio.off()
            prox_off()
        ringing = [c for c in calls.values() if c["state"] == "incoming"]
        media.set("stop" if audio.procs else "duck" if ringing else None)
        if not ringing:
            st["silenced"] = False
        st["ring_on"] = bool(ringing) and not st.get("silenced")
        if st["ring_on"]:
            ringtone.on(ringing[0]["number"])
            if "ring_vibrate" in st:
                st["ring_vibrate"](ringing[0]["number"])
        else:
            ringtone.off()

    def ringing_id():
        for cid, c in calls.items():
            if c["state"] in ("incoming", "waiting"):
                return cid
        return None

    def active_id():
        for cid, c in calls.items():
            if c["state"] not in ("end", "incoming", "waiting"):
                return cid
        return ringing_id()

    def answer():
        cid = ringing_id()
        if cid is None:
            return "no ringing call"
        i = Qmi.MessageVoiceAnswerCallInput()
        i.set_call_id(cid)
        try:
            req(voice, "answer_call", i)
            return "answered call %d" % cid
        except GLib.Error as e:
            return "answer: %s" % e.message

    def reject():
        cid = ringing_id()
        if cid is None:
            return "no ringing call"
        calls[cid]["rejected"] = True
        i = Qmi.MessageVoiceEndCallInput()
        i.set_call_id(cid)
        try:
            req(voice, "end_call", i)
            return "rejected call %d" % cid
        except GLib.Error as e:
            return "reject: %s" % e.message

    def dtmf(digit):
        cid = None
        for k, c in calls.items():
            if c["state"] == "conversation":
                cid = k
        if cid is None or len(digit) != 1 or digit not in "0123456789*#":
            return "no call to send it to"
        i = Qmi.MessageVoiceStartContinuousDtmfInput()
        i.set_data(cid, ord(digit))
        try:
            req(voice, "start_continuous_dtmf", i)
        except GLib.Error as e:
            return "dtmf: %s" % e.message

        def stop():
            j = Qmi.MessageVoiceStopContinuousDtmfInput()
            j.set_data(cid)
            try:
                req(voice, "stop_continuous_dtmf", j)
            except GLib.Error as e:
                dbg("dtmf stop: %s" % e.message)
            return False
        GLib.timeout_add(DTMF_MS, stop)
        tones.play(digit)
        return "ok"

    def speaker(how):
        if not audio.procs:
            return "no call"
        audio.route(not audio.speaker if how == "toggle" else how == "on")
        write_state()
        return "speaker" if audio.speaker else "earpiece"

    def mute(on):
        if not audio.procs:
            return "no call"
        st["mute"] = on
        cset(MUTE_CTL, "0" if on else "1")
        write_state()
        return "muted" if on else "unmuted"

    def reconcile(why):
        """Calls the modem no longer has, ended here too: a dial it refused
        after reporting the call (cc-in-progress, then IncompatibleState in
        limited service) never got an end, and the End key could not clear
        it (InvalidQosId)"""
        try:
            out = req(voice, "get_all_call_info", None)
            try:
                have = {c.id for c in out.get_call_information()}
            except GLib.Error:
                have = set()        # no calls at all
        except GLib.Error as e:
            log("call list (%s): %s" % (why, e.message))
            return
        gone = [cid for cid in calls if cid not in have]
        for cid in gone:
            log("call %d: the modem has no such call (%s)" % (cid, why))
            ended(cid, calls.pop(cid))
        if gone:
            if not calls:
                st["mute"] = False
            react()
            write_state()
        return gone

    def hangup():
        cid = active_id()
        if cid is None:
            return "no call"
        if calls[cid]["state"] in ("incoming", "waiting"):
            calls[cid]["rejected"] = True
        i = Qmi.MessageVoiceEndCallInput()
        i.set_call_id(cid)
        try:
            req(voice, "end_call", i)
            return "ended call %d" % cid
        except GLib.Error as e:
            if cid in (reconcile("end refused") or []):
                return "ended call %d (the modem had no such call)" % cid
            return "end: %s" % e.message

    def dial(number):
        if not number or any(ch not in "+0123456789*#" for ch in number):
            return "bad number"
        i = Qmi.MessageVoiceDialCallInput()
        i.set_calling_number(number)
        try:
            out = req(voice, "dial_call", i)
            return "dialling (call %s)" % (out.get_call_id() if hasattr(out, "get_call_id") else "?")
        except GLib.Error as e:
            reconcile("dial refused")
            return "dial: %s" % e.message

    def voicemail():
        num = st.get("voicemail", "")
        return dial(num) if num else "no voicemail number on the SIM"

    def status():
        if not calls:
            return "no calls"
        return "\n".join("%d %s %s %s" % (cid, c["dir"], c["state"], c["number"])
                         for cid, c in sorted(calls.items()))

    voice.connect("all-call-status", lambda _c, out: update(out))

    # Key and lid events
    def on_input(fd, _cond):
        while True:
            try:
                ev = os.read(fd, 24)
            except BlockingIOError:
                break
            if len(ev) < 24:
                break
            _s, _u, typ, code, val = struct.unpack("<qqHHi", ev)
            if typ == EV_KEY and val == 1:
                if code == SPEAKER_KEY and audio.procs:
                    log("speaker key: %s" % speaker("toggle"))
                elif code == KEY_ENTER and ringing_id() is not None:
                    log("Call key: %s" % answer())
                elif code == KEY_POWER and calls:
                    log("End key: %s" % hangup())
            elif typ == EV_SW and code == SW_LID and LID_ACTIONS:
                if val == 0 and ringing_id() is not None:
                    log("lid opened: %s" % answer())
                elif val == 1 and calls:
                    log("lid closed: %s" % hangup())
        return True

    for fd in keys:
        GLib.io_add_watch(fd, GLib.IO_IN, on_input)

    # Control socket
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o660)
    try:
        os.chown(SOCK, 0, grp.getgrnam("wheel").gr_gid)
    except (KeyError, OSError):
        pass
    srv.listen(4)

    def on_client(_fd, _cond):
        conn, _ = srv.accept()
        try:
            words = conn.recv(256).decode(errors="replace").split()
            cmd = words[0] if words else ""
            if cmd == "dial" and len(words) == 2:
                reply = dial(words[1])
            elif cmd == "answer":
                reply = answer()
            elif cmd == "hangup":
                reply = hangup()
            elif cmd == "reject":
                reply = reject()
            elif cmd == "voicemail":
                reply = voicemail()
            elif cmd == "silence":
                st["silenced"] = ringing_id() is not None
                react()
                reply = "silenced" if st["silenced"] else "no ringing call"
            elif cmd == "dtmf" and len(words) == 2:
                reply = dtmf(words[1])
            elif cmd == "mute" and len(words) == 2 and words[1] in ("on", "off"):
                reply = mute(words[1] == "on")
            elif cmd == "speaker" and len(words) == 2 and words[1] in ("on", "off", "toggle"):
                reply = speaker(words[1])
            elif cmd == "status":
                reply = status()
            else:
                reply = ("usage: dial NUMBER | voicemail | answer | hangup | reject | "
                         "dtmf DIGIT | mute on|off | status")
            if cmd not in ("dtmf", "status"):   # no numbers or tones in the log
                log("%s -> %s" % (cmd, reply.splitlines()[0] if reply else ""))
            conn.sendall((reply + "\n").encode())
        finally:
            conn.close()
        return True

    GLib.io_add_watch(srv.fileno(), GLib.IO_IN, on_client)

    def tick():
        audio.check()
        return True

    GLib.timeout_add(1500, tick)

    # The ring vibration: one step of the pattern at a time, while it rings
    def ring_steps(number):
        if setting("vibrate", "on") == "off":
            return []
        for v in (contact_field(number, "X-S22-CALLVIB"), setting("vib_ring", ""), RING):
            if v and v != "default":
                if v == "none":
                    return []
                try:
                    steps = [max(0, min(5000, int(x))) for x in v.split(",")][:16]
                except ValueError:
                    continue
                if len(steps) % 2:
                    steps.append(600)   # a pause before it comes round again
                if sum(steps) >= 200:
                    return steps
        return []

    def ring_step():
        if not st["ring_on"] or not st.get("ring_steps"):
            st["ring_timer"] = 0
            return False
        i = st["ring_i"] % len(st["ring_steps"])
        ms = st["ring_steps"][i]
        if i % 2 == 0 and ms:
            ringer.pulse(ms, st["ring_pct"])
        st["ring_i"] += 1
        st["ring_timer"] = GLib.timeout_add(max(ms, 20), ring_step)
        return False

    def ring_vibrate(number):
        if st.get("ring_timer"):
            return
        st["ring_steps"] = ring_steps(number)
        try:
            st["ring_pct"] = max(1, min(15, int(setting("vib_strength", 15)))) * 100 // 15
        except ValueError:
            st["ring_pct"] = 100
        st["ring_i"] = 0
        ring_step()
    st["ring_vibrate"] = ring_vibrate

    loop = GLib.MainLoop()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *_: loop.quit() or False)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda *_: loop.quit() or False)
    dev.connect("device-removed", lambda *_: loop.quit())
    write_state()
    def read_voicemail():
        """The SIM's mailbox number; at boot the SIM may not answer yet, so
        again a minute later, a few times"""
        st["voicemail"] = sim_voicemail()
        try:
            with open(VOICEMAIL + ".new", "w") as f:
                f.write(st["voicemail"] + "\n")
            os.replace(VOICEMAIL + ".new", VOICEMAIL)
        except OSError as e:
            log("voicemail: %s" % e)
        st["vm_tries"] = st.get("vm_tries", 0) + 1
        if st["voicemail"]:
            log("voicemail number found on the SIM")
        elif st["vm_tries"] < 10:
            GLib.timeout_add_seconds(60, lambda: read_voicemail() and False)
        else:
            log("voicemail number not on the SIM")
        return False

    read_voicemail()
    try:
        log_dir()
    except OSError as e:
        log("call log: %s" % e)
    log("ready (lid answers and hangs up: %s)" % ("yes" if LID_ACTIONS else "no"))
    try:
        loop.run()
    finally:
        ringtone.off()
        ringback.off()
        audio.off()
        try:
            os.unlink(SOCK)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
