def cset(name, value):
    r = subprocess.run(["amixer", "-q", "-c", "0", "cset", "name=" + name, value],
                       capture_output=True, text=True)
    if r.returncode:
        log("amixer %s=%s: %s" % (name, value, r.stderr.strip()))


def mix(controls):
    for n, v in controls:
        cset(n, v() if callable(v) else v)


class Audio:
    def __init__(self):
        self.procs = []
        self.speaker = False

    def hold(self):
        # Hostless: started and held, never read or written (s22-pcmhold)
        self.procs = [subprocess.Popen(["s22-pcmhold", PCM], stderr=subprocess.PIPE)]

    def release(self):
        for p in self.procs:
            p.terminate()
        for p in self.procs:
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                p.kill()
        self.procs = []

    def on(self):
        if self.procs:
            return
        mix(MIXER_ON)
        mix(SPEAKER if self.speaker else EARPIECE)
        mix(MEDIA_SPEAKER if self.speaker else MEDIA_EAR)
        self.hold()
        log("call audio on (%s, keypad mic)" % ("speaker" if self.speaker else "earpiece"))

    def route(self, speaker):
        """Earpiece or loudspeaker; a call in progress moves over"""
        if speaker == self.speaker:
            return
        self.speaker = speaker
        if not self.procs:
            return
        self.release()          # the voice session takes its ports at start
        mix(SPEAKER if speaker else EARPIECE)
        mix(MEDIA_SPEAKER if speaker else MEDIA_EAR)
        self.hold()
        log("call audio on the %s" % ("speaker" if speaker else "earpiece"))

    def off(self):
        if not self.procs:
            return
        self.release()
        mix(MIXER_OFF)
        mix(MEDIA_SPEAKER)
        self.speaker = False
        log("call audio off")

    def check(self):
        for p in self.procs:
            if p.poll() is not None:
                err = p.stderr.read().decode(errors="replace").strip() if p.stderr else ""
                log("voice PCM process exited (%s): %s" % (p.returncode, err[:200]))
                self.procs.remove(p)


# --------------------------------------------------------------- contacts
def contact_name(number):
    """The contact's name for a number (last ten digits agree), or None"""
    def tail(n):
        d = "".join(ch for ch in n if ch.isdigit())
        return d[-10:] if len(d) >= 7 else "=" + d
    want = tail(number or "")
    name, fn, nname = None, None, None
    try:
        with open(CONTACTS, errors="replace") as f:
            text = f.read().replace("\r\n ", "").replace("\n ", "")
    except OSError:
        return None
    for line in text.splitlines():
        key, _, val = line.partition(":")
        key = key.split(".")[-1].upper()
        if key == "BEGIN":
            fn = nname = None
        elif key == "FN" or key.startswith("FN;"):
            fn = val.replace("\\,", ",").replace("\\;", ";")
        elif key == "N" or key.startswith("N;"):
            p = val.split(";") + ["", ""]
            nname = (p[1] + " " + p[0]).strip()
        elif key.startswith("TEL") and number and tail(val) == want:
            name = fn or nname
            if name:
                return name
    return None


def contact_field(number, field):
    """A contact's FIELD (X-S22-RINGTONE) for a number, or "" """
    def tail(n):
        d = "".join(ch for ch in n if ch.isdigit())
        return d[-10:] if len(d) >= 7 else "=" + d
    want = tail(number or "")
    try:
        with open(CONTACTS, errors="replace") as f:
            text = f.read().replace("\r\n ", "").replace("\n ", "")
    except OSError:
        return ""
    match, val = False, ""
    for line in text.splitlines():
        key, _, v = line.partition(":")
        key = key.split(".")[-1].upper()
        if key == "BEGIN":
            match, val = False, ""
        elif key.startswith("TEL") and number and tail(v) == want:
            match = True
        elif key == field or key.startswith(field + ";"):
            val = v.strip()
        elif key == "END" and match:
            return val
    return ""


def pipewire_env():
    """s22-play and aplay into the loudspeaker node of the GUI's PipeWire"""
    if not os.path.exists(PIPEWIRE_DIR + "/pipewire-0"):
        return None
    env = dict(os.environ, PIPEWIRE_RUNTIME_DIR=PIPEWIRE_DIR, PIPEWIRE_NODE="s22.speaker")
    return env


def say(line, timeout=None):
    """A line to s22-say ("wait TEXT", "stop"); its answer, or None"""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(SAY_SOCK)
            s.sendall((line + "\n").encode())
            return s.makefile().readline().strip()
    except OSError:
        return None


def spoken_who(number):
    """Who is calling, to be said: the contact, or the number digit by digit"""
    name = contact_name(number)
    if name:
        return name
    digits = " ".join(ch for ch in number if ch.isdigit())
    return digits or "an unknown number"


class Ringtone:
    """The ringtone, looping, until the call is answered, ends or is
    silenced; with tts_calls=on, the caller's name between rings"""
    def __init__(self):
        self.p = None
        self.lock = threading.Lock()
        self.ringing = False
        self.thread = None
        self.gen = 0                # a new ring's, so an old thread ends

    def on(self, number):
        if self.ringing or setting("sounds", "on") == "off":
            return
        tone = contact_field(number, "X-S22-RINGTONE") or setting("ringtone", DEFAULT_RINGTONE)
        if tone == "silent":
            return
        if not os.access(tone, os.R_OK):
            tone = DEFAULT_RINGTONE
        self.ringing = True
        self.gen += 1
        if setting("tts_calls", "off") == "on":
            self.thread = threading.Thread(target=self.speak_and_ring,
                                           args=(tone, spoken_who(number), self.gen),
                                           daemon=True)
            self.thread.start()
        else:
            self.play(tone)

    def play(self, tone):
        with self.lock:
            if not self.ringing or self.p:
                return
            try:
                self.p = subprocess.Popen(["s22-play", "-l", tone], stderr=subprocess.DEVNULL)
            except OSError as e:
                log("ringtone: %s" % e)

    def quiet(self):
        with self.lock:
            p, self.p = self.p, None
        if p:
            p.terminate()
            try:
                p.wait(2)
            except subprocess.TimeoutExpired:
                p.kill()

    def speak_and_ring(self, tone, name, gen):
        def still():
            return self.ringing and self.gen == gen
        while still():
            # Said, or stopped by off(); without s22-say, the ringtone alone
            if say("wait Call from %s" % name, timeout=20) is None:
                dbg("s22-say: not there")
            if not still():
                break
            self.play(tone)
            end = time.monotonic() + RING_SPELL
            while still() and time.monotonic() < end:
                time.sleep(0.1)
            if self.gen == gen:
                self.quiet()

    def off(self):
        if not self.ringing:
            return
        self.ringing = False
        if self.thread:
            say("stop", timeout=2)
            self.thread = None
        self.quiet()


def sim_record(fid, rec, length):
    """A record of a USIM file, as bytes, or None"""
    try:
        r = subprocess.run(["qmicli", "-d", QMI_DEV, "--uim-read-record=record-number=%d,"
                            "record-length=%d,file=%s%s" % (rec, length, USIM, fid)],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = r.stdout.split("Read result:", 1)
    if r.returncode or len(out) < 2:
        return None
    try:
        return bytes.fromhex("".join(ch for ch in out[1] if ch in "0123456789abcdefABCDEF"))
    except ValueError:
        return None


def sim_voicemail():
    """The voicemail number from the SIM (EF_MBI, EF_MBDN), or "" """
    mbi = sim_record("0x6FC9", 1, 4)
    rec = mbi[0] if mbi and 0 < mbi[0] < 0xff else 1
    b = sim_record("0x6FC7", rec, 24)
    if not b or len(b) < 14:
        return ""
    n, ton, bcd = b[-14], b[-13], b[-12:-2]
    if n in (0, 0xff):
        return ""
    digits = "".join("0123456789*#"[x] for byte in bcd[:n - 1]
                     for x in (byte & 15, byte >> 4) if x < 12)
    return ("+" if (ton & 0x70) == 0x10 else "") + digits


def who(number):
