class Ringback:
    """The ringback tone with the voice path (Audio routes the card's media
    playback there for the call)"""
    CMD = "s22-ringback | aplay -q -t raw -f S16_LE -r 48000 -c 2 -D %s"

    def __init__(self):
        self.p = None

    def on(self):
        if self.p:
            return
        # Through the sound server when it runs, which holds the card
        env = tone_env()
        self.p = subprocess.Popen(self.CMD % ("pipewire" if env else "hw:0,0"), shell=True,
                                  start_new_session=True, stderr=subprocess.DEVNULL, env=env)
        dbg("ringback on")

    def off(self):
        if not self.p:
            return
        try:
            os.killpg(self.p.pid, signal.SIGTERM)
        except OSError:
            pass
        try:
            self.p.wait(2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(self.p.pid, signal.SIGKILL)
            except OSError:
                pass
        self.p = None
        dbg("ringback off")


DTMF_FREQS = {d: (r, c) for row, r in zip(("123", "456", "789", "*0#"), (697, 770, 852, 941))
              for d, c in zip(row, (1209, 1336, 1477))}


class Tones:
    """A digit's DTMF tone with the voice, as it is sent: its row's and its
    column's frequencies for DTMF_MS, at the ringback's level"""
    LEVEL = 0.12
    RATE = 48000

    def __init__(self):
        self.pcm = {}

    def wave(self, digit):
        if digit not in self.pcm:
            r, c = DTMF_FREQS[digit]
            n = self.RATE * DTMF_MS // 1000
            ramp = self.RATE // 200
            out = bytearray()
            for i in range(n):
                env = min(1.0, i / ramp, (n - 1 - i) / ramp)
                v = self.LEVEL * env * (math.sin(2 * math.pi * r * i / self.RATE) +
                                        math.sin(2 * math.pi * c * i / self.RATE))
                out += struct.pack("<h", int(v * 32767))
            self.pcm[digit] = bytes(out)
        return self.pcm[digit]

    def play(self, digit):
        if digit not in DTMF_FREQS:
            return
        env = tone_env()
        try:
            p = subprocess.Popen(["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r",
                                  str(self.RATE), "-c", "1", "-D",
                                  "pipewire" if env else "hw:0,0"],
                                 stdin=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
        except OSError as e:
            log("tone: %s" % e)
            return

        def feed():
            try:
                p.stdin.write(self.wave(digit))
                p.stdin.close()
            except OSError:
                pass
            p.wait()
        threading.Thread(target=feed, daemon=True).start()


