+++ b/src/api/pin_add.zig
@@ -23,11 +23,16 @@ fn pin_add(mepo: *Mepo, group: i32, is_structural: bool, lat: f64, lon: f64, han
     const pin_group: usize = if (group < 0) mepo.pin_group_active else @intCast(group);
     defer mepo.blit_pinlayer_cache.clearAndFree();
 
-    // E.g. nop if adding a pin_handle that already exists
+    // A pin_handle that already exists: the pin moves there (BENCtix-CAT:
+    // the position pin follows the GPS; it stayed at the first fix)
     if (handle.len != 0) {
-        for (mepo.pin_groups[pin_group].items) |pin| {
+        for (mepo.pin_groups[pin_group].items) |*pin| {
             if (pin.handle) |pin_handle| {
-                if (std.mem.eql(u8, pin_handle, handle)) return;
+                if (std.mem.eql(u8, pin_handle, handle)) {
+                    pin.lat = lat;
+                    pin.lon = lon;
+                    return;
+                }
             }
         }
     }
