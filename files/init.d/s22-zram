#!/sbin/openrc-run
# Swap on compressed RAM (D001: no swap on the eMMC or the SD card).

description="zram swap"

depend() {
	need localmount
}

start() {
	ebegin "Starting zram swap"
	local mem dev=/dev/zram0
	[ -e /sys/block/zram0 ] || modprobe zram || { eend 1; return 1; }
	mem=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
	echo "${ZRAM_ALGORITHM:-zstd}" > /sys/block/zram0/comp_algorithm 2>/dev/null
	echo "$((mem * ${ZRAM_PERCENT:-50} / 100))K" > /sys/block/zram0/disksize &&
		mkswap -q "$dev" && swapon -p 100 "$dev"
	eend $?
}

stop() {
	ebegin "Stopping zram swap"
	swapoff /dev/zram0 2>/dev/null
	echo 1 > /sys/block/zram0/reset
	eend 0
}
