#!/sbin/openrc-run
# USB network to the host: an NCM gadget, the phone at USBNET_ADDR, the host
# gets the next address from dnsmasq (D012).

description="USB network gadget (NCM) to the host"

G=/sys/kernel/config/usb_gadget/s22

depend() {
	need localmount
	before dnsmasq sshd
}

start() {
	ebegin "Starting the USB network gadget"
	modprobe libcomposite || { eend 1 "libcomposite missing"; return 1; }
	mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
	if [ ! -d "$G" ]; then
		mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/ncm.usb0"
		echo 0x18D1 > "$G/idVendor"
		echo 0xD001 > "$G/idProduct"
		echo "Cat" > "$G/strings/0x409/manufacturer"
		echo "S22 Flip (BENCtix-CAT)" > "$G/strings/0x409/product"
		echo "benctix-cat" > "$G/strings/0x409/serialnumber"
		echo "NCM" > "$G/configs/c.1/strings/0x409/configuration"
		# Fixed, locally administered addresses so the host keeps its profile
		echo "${USBNET_DEV_MAC:-02:22:f1:1b:00:01}" > "$G/functions/ncm.usb0/dev_addr"
		echo "${USBNET_HOST_MAC:-02:22:f1:1b:00:02}" > "$G/functions/ncm.usb0/host_addr"
		ln -s "$G/functions/ncm.usb0" "$G/configs/c.1/"
	fi
	udc=
	for i in $(seq 30); do
		udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
		[ -n "$udc" ] && break
		sleep 1
	done
	[ -n "$udc" ] || { eend 1 "no USB device controller"; return 1; }
	[ "$(cat "$G/UDC")" = "$udc" ] || echo "$udc" > "$G/UDC"
	for i in $(seq 10); do
		[ -e /sys/class/net/usb0 ] && break
		sleep 1
	done
	ip addr replace "${USBNET_ADDR:-172.16.42.1}/24" dev usb0 &&
		ip link set usb0 up
	eend $?
}

stop() {
	ebegin "Stopping the USB network gadget"
	ip addr flush dev usb0 2>/dev/null
	[ -e "$G/UDC" ] && echo "" > "$G/UDC"
	eend 0
}
